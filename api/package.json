{
  "name": "api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "primer-cobro": "tsx scripts/primer-cobro.ts",
    "db:reset": "tsx src/db/migrar.ts limpia",
    "db:reset:demo": "tsx src/db/migrar.ts demo",
    "db:semilla:ui": "tsx src/db/migrar.ts semilla-ui",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:3100": "tsx watch --env-file=config/puerto-3100.env src/main.ts",
    "start:3100": "tsx --env-file=config/puerto-3100.env src/main.ts",
    "guion": "tsx scripts/guion.ts"
  },
  "dependencies": {
    "@interledger/open-payments": "7.4.0",
    "express": "5.2.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
