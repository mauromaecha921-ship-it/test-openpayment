# Copiar a .env (en la raíz del repo) y completar. El .env está ignorado por git: nunca se sube.
# La API lee este .env y, si existe, también server/.env (manda el de la raíz).
#
# En Vercel no hay .env: estas variables van en el proyecto (Settings → Environment Variables).
# Allá APP_BASE_URL, API_BASE_URL y LIQUIDACION_URL se completan solas con el dominio del despliegue,
# DATABASE_URL es obligatoria (Supabase, pooler 6543) y la llave va en OP_PRIVATE_KEY_BASE64.
# Detalle: server/README.md § Despliegue en Vercel.

PORT=3000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000/api
LIQUIDACION_URL=http://localhost:3000/api/liquidacion
# Banco puente de Bre-B (Plan Bre-B). Vacío: el simulador de esta API, en API_BASE_URL/puente
PUENTE_URL=
# Base de datos (piloto-v2: PostgreSQL)
# - Supabase: la URL del pooler (Project Settings → Database). Si la contraseña tiene @, #, +, /, ?, : o %,
#   escríbelos codificados (%40, %23, %2B, %2F, %3F, %3A, %25): si no, la URL apunta a otro servidor (D-44).
#   DATABASE_URL=postgresql://postgres.<proyecto>:<contraseña-codificada>@aws-0-<región>.pooler.supabase.com:5432/postgres
#   (5432 en local; en Vercel, el 6543). OJO: es la misma base que usa Vercel: db:reset borraría producción.
# - Sin internet o para programar: PostgreSQL local con PGlite en server/data/pglite (es lo que se usa
#   si no hay DATABASE_URL), separado de producción
DATABASE_URL=pglite:./data/pglite

# Cliente Open Payments: solo backend
OP_CLIENT_WALLET_ADDRESS=
OP_KEY_ID=
# Una de las dos, nunca en el repo (en Vercel, la BASE64)
OP_PRIVATE_KEY_BASE64=
OP_PRIVATE_KEY_PATH=

# Wallets del guion de la demo (Test Wallet, en COP). Solo las usa «pnpm --filter api db:reset:demo»:
# para pagos entre el equipo no hacen falta (cada quien se registra en la app).
DEMO_WALLET_PROGRAMA=
DEMO_WALLET_ANA=
DEMO_WALLET_LUIS=
DEMO_WALLET_PUNTO=

# Reglas (Historias § Variables)
CONFIRMACION_TTL_SEG=120
PIN_MAX_INTENTOS=3
PIN_BLOQUEO_MIN=15
POLL_INTERVALO_MS=1000
APROBACION_TTL_MIN=10
# El token del permiso dura 600 s en la Test Wallet: se renueva cada tanto (D-35)
TOKEN_RENOVAR_CADA_SEG=240
# subject | simulada (plan B de HU-07)
VERIFICACION_CUENTA=subject
LIQUIDACION_SIMULAR_FALLA=false
PUENTE_SIMULAR_FALLA=false
# Monto base de la liquidación simulada ($230.000). Con 230000 ($2.300) el guion gasta $4.600
LIQUIDACION_MONTO_BASE=23000000

# Fase 1 (scripts/primer-cobro.ts): monto de cada pago de prueba en unidades mínimas ($10.000)
MONTO_PRUEBA=1000000

# Extras (RNF-10)
EXTRA_BONO=false
EXTRA_QR=false
EXTRA_PDF417=false
EXTRA_CONTRATO=false
EXTRA_DEPLOY=false
QR_TTL_SEG=60
