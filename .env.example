# Copiar a .env y completar. Los valores reales NUNCA se commitean (RNF-01).
# Fuente: Historias § Variables · Estructura del proyecto § 6.

# Cliente Open Payments (solo backend; la llave privada vive fuera del repo)
OP_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/entrega-app
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=./private.key

# PostgreSQL (Supabase o Neon)
DATABASE_URL=postgres://usuario:password@host:5432/tatu

# Liquidación simulada de la entidad: apunta al router /liquidacion de esta
# misma API, o a otro proceso, sin cambiar código (AD-13 / P-02)
LIQUIDACION_URL=http://localhost:3000/liquidacion

# URLs públicas: volver a la app tras aprobar y callbacks de Open Payments
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Puerto de la API (opcional; por defecto 3000)
PORT=3000

# Cadencia de consulta del estado desde el punto y la app (AD-16)
POLL_INTERVALO_MS=1000

# Extras (RNF-10): cada uno tras su bandera; apagado no rompe el flujo principal
EXTRA_BONO=false
EXTRA_QR=false
EXTRA_PDF417=false
EXTRA_CONTRATO=false
EXTRA_DEPLOY=false
